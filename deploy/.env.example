TZ=Asia/Shanghai
CODEXMANAGER_WEB_PORT=48761

# Required for the secure Compose profiles. Create this file with mode 0600;
# CodexManager reads it once to initialize Web password authentication.
CODEXMANAGER_WEB_ACCESS_PASSWORD_FILE_HOST=/absolute/path/to/codexmanager-web-access-password
# Set to 1 for exactly one restart only when deliberately rotating the password.
CODEXMANAGER_WEB_ACCESS_PASSWORD_RESET=0

# Optional LabContext integration. See docker-compose.labcontext.example.yml.
# LABCONTEXT_ADMIN_URL=http://host.docker.internal:1455/admin
# LABCTX_ADMIN_TOKEN_FILE_HOST=/absolute/path/to/labcontext/admin.token
